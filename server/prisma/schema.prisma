generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  USER
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

model User {
  id                     String      @id @default(uuid())
  fullName               String
  email                  String      @unique
  mobileNumber           String?
  password               String
  profilePicture         String?
  role                   Role        @default(USER)
  isEmailVerified        Boolean     @default(false)
  emailVerificationToken String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  properties             Property[]
  inquiriesSent          Inquiry[]   @relation("BuyerInquiries")
  favorites              Favorite[]
  auditLogs              AuditLog[]  @relation("AdminLogs")
}

model Property {
  id               String         @id @default(uuid())
  title            String
  description      String
  propertyType     String
  saleOrRent       String
  price            Float
  pricePerPerch    String?
  landSize         Float?
  landUnit         String?        @default("perches")
  negotiable       Boolean        @default(false)
  bedrooms         Int?
  bathrooms        Int?
  parking          Int?
  houseSize        Float?
  yearBuilt        Int?

  address          String
  district         String
  city             String
  latitude         Float?
  longitude        Float?

  amenities        String[]
  nearbyFacilities String[]

  contactPhone     String
  contactEmail     String
  whatsappNumber   String?

  images           String[]
  video            String?

  status           PropertyStatus @default(DRAFT)
  isFeatured       Boolean        @default(false)

  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inquiries        Inquiry[]
  favorites        Favorite[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Inquiry {
  id           String    @id @default(uuid())

  senderName   String
  senderEmail  String
  senderPhone  String?
  message      String

  buyerId      String?
  buyer        User?     @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: SetNull)

  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ipAddress    String?

  createdAt    DateTime  @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String
  adminId   String
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)
  targetId  String?  // ID of the user or property affected
  createdAt DateTime @default(now())
}
